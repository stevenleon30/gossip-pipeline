# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: use another Claude model (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=

# Needed only when GENERATE_ASSETS=true
REPLICATE_API_TOKEN=your_replicate_api_token_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# VIDEO_MODEL=bytedance/seedance-1-lite

# Pipeline behavior
# Default is a dry run: scripts and prompts only, empty placeholder clips.
# Set to true to call Replicate and ElevenLabs (costs money).
GENERATE_ASSETS=false
# Used when no product is passed on the command line
# PRODUCT_NAME=Sol de Janeiro Brazilian Bum Bum Cream

# HTTP server (npm start)
# PORT=3001
# Comma-separated list of allowed origins. Unset means any origin.
# CORS_ORIGIN=http://localhost:5173
# If set, POST /api/generate requires "Authorization: Bearer <token>"
# API_AUTH_TOKEN=
