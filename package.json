{
  "name": "gossip-pipeline",
  "version": "1.1.0",
  "description": "Three Claude agents that turn a product into a TikTok storytime script, scene prompts, and optional video clips.",
  "private": true,
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "pipeline": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "keywords": [
    "claude",
    "anthropic",
    "ai-agents",
    "tiktok",
    "ugc",
    "seedance",
    "replicate",
    "typescript"
  ],
  "author": "Steven Leon",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "replicate": "^1.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
